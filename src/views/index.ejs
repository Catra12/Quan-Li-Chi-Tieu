<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản Lý Chi Tiêu Cá Nhân | DevOps Project</title>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
      --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .hero-header {
      background: var(--primary-gradient);
      color: white;
      padding: 2.5rem 0 3rem;
      border-radius: 0 0 1.5rem 1.5rem;
      box-shadow: 0 10px 20px rgba(79, 70, 229, 0.15);
      margin-bottom: -2rem;
    }
    .custom-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      box-shadow: var(--card-shadow);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card {
      border-left: 5px solid #4f46e5;
    }
    .stat-amount {
      font-size: 2rem;
      font-weight: 700;
      color: #0f172a;
    }
    .category-badge {
      font-weight: 500;
      padding: 0.35rem 0.65rem;
      border-radius: 0.5rem;
    }
    .table > :not(caption) > * > * {
      padding: 0.9rem 0.75rem;
      vertical-align: middle;
    }
    .table-hover tbody tr:hover {
      background-color: #f1f5f9;
    }
    .btn-gradient {
      background: var(--primary-gradient);
      color: white;
      border: none;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .btn-gradient:hover {
      background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
      color: white;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    }
    .footer {
      margin-top: auto;
      padding: 1.5rem 0;
      color: #64748b;
      font-size: 0.875rem;
      border-top: 1px solid #e2e8f0;
      background: #ffffff;
    }
  </style>
</head>
<body>

  <!-- Top Navigation & Header -->
  <header class="hero-header">
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-semibold mb-2 shadow-sm">
            <i class="bi bi-gear-wide-connected me-1"></i> DevOps Project
          </span>
          <h1 class="h2 fw-bold mb-1">
            <i class="bi bi-wallet2 me-2"></i>Quản Lý Chi Tiêu Cá Nhân
          </h1>
          <p class="mb-0 text-white-50">Hệ thống theo dõi và quản lý thu chi tiện lợi, nhanh chóng</p>
        </div>
        <div class="text-md-end">
          <a href="/health" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3 py-2">
            <i class="bi bi-activity me-1 text-success"></i> Health Check API
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="container my-5">
    <% if (error) { %>
      <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
      <div class="col-md-6 col-lg-6">
        <div class="custom-card stat-card p-4">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-uppercase text-muted fw-semibold small mb-1">Tổng Chi Tiêu</p>
              <div class="stat-amount text-danger">
                <%= Number(totalAmount).toLocaleString('vi-VN') %> <span class="fs-5 text-muted fw-normal">VNĐ</span>
              </div>
            </div>
            <div class="bg-danger-subtle text-danger rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
              <i class="bi bi-cash-stack fs-3"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-lg-6">
        <div class="custom-card p-4" style="border-left: 5px solid #06b6d4;">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-uppercase text-muted fw-semibold small mb-1">Tổng Số Giao Dịch</p>
              <div class="stat-amount text-primary">
                <%= expenses.length %> <span class="fs-5 text-muted fw-normal">khoản</span>
              </div>
            </div>
            <div class="bg-info-subtle text-info rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
              <i class="bi bi-receipt fs-3"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Form & Table Section -->
    <div class="row g-4">
      <!-- Form Thêm Chi Tiêu -->
      <div class="col-lg-4">
        <div class="custom-card p-4 sticky-top" style="top: 2rem; z-index: 10;">
          <h2 class="h5 fw-bold mb-3 d-flex align-items-center">
            <i class="bi bi-plus-circle text-primary me-2"></i>Thêm Khoản Chi Mới
          </h2>
          <form action="/expenses" method="POST">
            <div class="mb-3">
              <label for="title" class="form-label fw-semibold small text-secondary">Nội dung chi tiêu <span class="text-danger">*</span></label>
              <input type="text" class="form-control rounded-3" id="title" name="title" placeholder="VD: Mua sách, Tiền ăn trưa..." required>
            </div>

            <div class="mb-3">
              <label for="amount" class="form-label fw-semibold small text-secondary">Số tiền (VNĐ) <span class="text-danger">*</span></label>
              <div class="input-group">
                <input type="number" class="form-control rounded-start-3" id="amount" name="amount" min="1" step="any" placeholder="VD: 50000" required>
                <span class="input-group-text bg-light text-muted rounded-end-3">₫</span>
              </div>
            </div>

            <div class="mb-4">
              <label for="category" class="form-label fw-semibold small text-secondary">Danh mục</label>
              <select class="form-select rounded-3" id="category" name="category">
                <option value="Ăn uống" selected>🍽️ Ăn uống</option>
                <option value="Đi lại">🛵 Đi lại / Xăng xe</option>
                <option value="Nhà ở">🏠 Tiền trọ / Điện nước</option>
                <option value="Mua sắm">🛍️ Mua sắm</option>
                <option value="Học tập">📚 Học tập & Sách</option>
                <option value="Giải trí">🎮 Giải trí / Phim ảnh</option>
                <option value="Sức khỏe">💊 Sức khỏe / Y tế</option>
                <option value="Khác">✨ Khác</option>
              </select>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2 rounded-3 shadow-sm">
              <i class="bi bi-check-circle me-1"></i> Lưu Khoản Chi
            </button>
          </form>
        </div>
      </div>

      <!-- Danh Sách Chi Tiêu -->
      <div class="col-lg-8">
        <div class="custom-card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 fw-bold mb-0">
              <i class="bi bi-card-checklist text-primary me-2"></i>Danh Sách Khoản Chi
            </h2>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill">
              <%= expenses.length %> bản ghi
            </span>
          </div>

          <% if (expenses && expenses.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr class="text-secondary small">
                    <th scope="col" style="width: 5%;">#</th>
                    <th scope="col" style="width: 35%;">Nội dung</th>
                    <th scope="col" style="width: 20%;">Danh mục</th>
                    <th scope="col" style="width: 20%;" class="text-end">Số tiền</th>
                    <th scope="col" style="width: 20%;" class="text-end">Hành động</th>
                  </tr>
                </thead>
                <tbody>
                  <% expenses.forEach((expense, index) => { %>
                    <tr>
                      <td class="text-muted small"><%= index + 1 %></td>
                      <td>
                        <div class="fw-semibold text-dark"><%= expense.title %></div>
                        <div class="small text-muted">
                          <i class="bi bi-clock me-1"></i><%= new Date(expense.createdAt).toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' }) %>
                        </div>
                      </td>
                      <td>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle category-badge">
                          <%= expense.category || 'Khác' %>
                        </span>
                      </td>
                      <td class="text-end fw-bold text-danger">
                        <%= Number(expense.amount).toLocaleString('vi-VN') %> ₫
                      </td>
                      <td class="text-end">
                        <form action="/expenses/<%= expense._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khoản chi này?');">
                          <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1" title="Xóa khoản chi">
                            <i class="bi bi-trash3"></i> Xóa
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <div class="text-muted mb-3">
                <i class="bi bi-inbox fs-1"></i>
              </div>
              <h5 class="fw-bold text-secondary">Chưa có khoản chi tiêu nào</h5>
              <p class="text-muted small mb-0">Hãy bắt đầu ghi chép chi tiêu bằng biểu mẫu bên cạnh nhé!</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container text-center">
      <p class="mb-1 fw-semibold text-secondary">Ứng Dụng Quản Lý Chi Tiêu Cá Nhân</p>
      <p class="mb-0 text-muted small">
        Node.js • Express • Mongoose • EJS | Đồ án môn học DevOps
      </p>
    </div>
  </footer>

  <!-- Bootstrap 5 JS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
